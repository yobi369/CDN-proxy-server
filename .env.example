HOST=127.0.0.1
PORT=8080
# Required when HOST is not loopback; use a long random secret.
PROXY_API_KEY=
CACHE_DIR=./cache
MAX_CACHE_SIZE_BYTES=1073741824
MAX_RESPONSE_SIZE_BYTES=26214400
CACHE_TTL_SECONDS=3600
UPSTREAM_TIMEOUT_SECONDS=20
RATE_LIMIT_PER_MINUTE=120
ANALYTICS_DB=./analytics.db
# Comma-separated exact browser origins; empty means no cross-origin access.
CORS_ORIGINS=
LOG_LEVEL=INFO
