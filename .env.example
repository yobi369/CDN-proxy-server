# Copy to .env and replace the example hostnames and secret.
# Use only origin hosts you control or are authorized to proxy.
CDN_ALLOWED_HOSTS=example.com,www.example.com
PROXY_STATS_TOKEN=replace-with-a-long-random-secret
PROXY_PORT=8080
PROXY_MAX_CACHE_BYTES=268435456
PROXY_MAX_OBJECT_BYTES=8388608
PROXY_DEFAULT_TTL=300
PROXY_MAX_TTL=86400
PROXY_TIMEOUT_SECONDS=15
PROXY_RATE_LIMIT=120
